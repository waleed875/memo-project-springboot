# CI-only runtime image: the Spring Boot JAR is built on the GitHub runner with cached Maven dependencies.
# This is intentionally distinct from the standalone source-build backend/Dockerfile.
FROM eclipse-temurin:21-jdk-noble AS probe
COPY backend/docker/HealthProbe.java /tmp/HealthProbe.java
RUN mkdir -p /tmp/probe && javac -d /tmp/probe /tmp/HealthProbe.java

FROM eclipse-temurin:21-jre-noble
RUN groupadd --system --gid 10001 memo && \
    useradd --system --uid 10001 --gid memo --no-create-home --shell /usr/sbin/nologin memo
WORKDIR /app
COPY --chown=10001:10001 backend/target/memo-api-0.1.0-SNAPSHOT.jar /app/app.jar
COPY --from=probe --chown=10001:10001 /tmp/probe/ /opt/probe/
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["java", "-cp", "/opt/probe", "HealthProbe"]
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
